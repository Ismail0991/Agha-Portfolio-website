<script>
  (() => {
    const toggle = document.getElementById("navToggle");
    const menu = document.getElementById("mobileMenu");
    const icon = document.getElementById("navToggleIcon");

    toggle.addEventListener("click", () => {
      const open = !menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(open));
      icon.className = open ? "fas fa-xmark" : "fas fa-bars";
    });

    // Mobile Services accordion.
    const sToggle = document.getElementById("mobileServicesToggle");
    const sMenu = document.getElementById("mobileServices");
    const sIcon = document.getElementById("mobileServicesIcon");
    sToggle.addEventListener("click", () => {
      const open = !sMenu.classList.toggle("hidden");
      sToggle.setAttribute("aria-expanded", String(open));
      sIcon.classList.toggle("rotate-180", open);
    });

    // Mark the current page in both menus.
    const path = window.location.pathname;
    document.querySelectorAll("#siteNav a[href^='/']").forEach((a) => {
      const href = a.getAttribute("href");
      const active = href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
      if (active && !a.classList.contains("primary-btn")) a.classList.add("nav-active");
    });
  })();
</script>
