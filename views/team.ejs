<!-- ============================ HERO ============================ -->
<section class="hero-section relative overflow-hidden">
  <div class="absolute inset-0 grid-bg pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 pt-20 pb-20 lg:pt-28 lg:pb-24">
    <div class="max-w-3xl">
      <div class="eyebrow mb-6 reveal">
        <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
        The People
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.08] mb-6 reveal">
        Our Team —<br>
        the people <span class="gradient-text">behind Aghaz Digital</span>
      </h1>

      <p class="text-lg text-gray-400 leading-relaxed max-w-xl mb-9 reveal">
        Meet the talented people behind Aghaz Digital. Senior builders, designers and
        strategists who scope your project and then actually build it — no handoffs,
        no bait and switch.
      </p>

      <div class="flex flex-wrap gap-3 reveal">
        <a href="/contact" class="primary-btn">
          Work With Us <i class="fas fa-arrow-right text-xs"></i>
        </a>
        <a href="/careers" class="ghost-btn">
          <i class="fas fa-briefcase text-xs"></i> See Open Roles
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ========================= STATS STRIP ========================= -->
<section class="border-y border-white/10 bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="reveal">
        <p class="text-3xl font-bold text-brand font-display" data-count="18" data-suffix="+">0</p>
        <p class="text-sm text-gray-500 mt-1">Team Members</p>
      </div>
      <div class="reveal">
        <p class="text-3xl font-bold text-brand font-display" data-count="5" data-suffix="+">0</p>
        <p class="text-sm text-gray-500 mt-1">Years Together</p>
      </div>
      <div class="reveal">
        <p class="text-3xl font-bold text-brand font-display" data-count="12" data-suffix="+">0</p>
        <p class="text-sm text-gray-500 mt-1">Disciplines</p>
      </div>
      <div class="reveal">
        <p class="text-3xl font-bold text-brand font-display" data-count="4" data-suffix="">0</p>
        <p class="text-sm text-gray-500 mt-1">Time Zones</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================== TEAM GRID ========================== -->
<section class="py-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="max-w-2xl mb-14 reveal">
      <div class="eyebrow mb-4">Who You Will Work With</div>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Small team, <span class="gradient-text">deep bench</span>
      </h2>
      <p class="text-gray-400 leading-relaxed">
