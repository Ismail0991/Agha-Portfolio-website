<!-- ========================= WHY CHOOSE US ========================= -->
<section class="py-24 border-y border-white/10 bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left column: each element reveals one after another via staggered AOS delays. -->
      <div>
        <div class="eyebrow mb-4" data-aos="fade-right" data-aos-delay="0" data-aos-duration="650"><%= content['why.eyebrow'] %></div>
        <h2 class="text-3xl sm:text-4xl font-bold mb-5" data-aos="fade-right" data-aos-delay="100" data-aos-duration="750">
          <%= content['why.titlePre'] %> <span class="gradient-text"><%= content['why.titleHighlight'] %></span>
        </h2>
        <p class="text-gray-400 leading-relaxed mb-6" data-aos="fade-right" data-aos-delay="200" data-aos-duration="650">
          Most companies end up stitching together five vendors — one for marketing, one for
          the website, one for branding, one for software — and spend more time managing
          handoffs than getting results.
        </p>
        <p class="text-gray-400 leading-relaxed mb-8" data-aos="fade-right" data-aos-delay="300" data-aos-duration="650">
          We work differently. Every service connects to the next: your brand strategy informs
          your marketing, your marketing informs your website, and your software is built to
          support all of it. Your marketing message matches your brand, and nobody's pointing
          fingers when something falls through the cracks.
        </p>
        <div class="space-y-4">
          <div class="flex gap-4" data-aos="fade-right" data-aos-delay="400" data-aos-duration="650">
            <span class="service-icon shrink-0"><i class="fas fa-handshake-angle"></i></span>
            <div>
              <h3 class="font-semibold mb-1">One accountable team</h3>
              <p class="text-sm text-gray-400 leading-relaxed">Across marketing, brand, and technology — no handoffs between agencies.</p>
            </div>
          </div>
          <div class="flex gap-4" data-aos="fade-right" data-aos-delay="500" data-aos-duration="650">
            <span class="service-icon shrink-0"><i class="fas fa-ruler-combined"></i></span>
            <div>
              <h3 class="font-semibold mb-1">Scoped to your business</h3>
              <p class="text-sm text-gray-400 leading-relaxed">Every recommendation fits your goals, not a package deal sold to everyone.</p>
            </div>
          </div>
          <div class="flex gap-4" data-aos="fade-right" data-aos-delay="600" data-aos-duration="650">
            <span class="service-icon shrink-0"><i class="fas fa-chart-line"></i></span>
            <div>
              <h3 class="font-semibold mb-1">Measured on real outcomes</h3>
              <p class="text-sm text-gray-400 leading-relaxed">Leads, revenue, cost savings, and efficiency gains — not vague deliverables.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-5">
        <div class="glass p-7" data-aos="fade-down-right" data-aos-delay="150" data-aos-duration="650">
          <span class="service-icon mb-4"><i class="fas fa-rocket"></i></span>
          <h3 class="font-semibold mb-1.5">Startups</h3>
          <p class="text-sm text-gray-400 leading-relaxed">Building your first real go-to-market motion.</p>
        </div>
        <div class="glass p-7 mt-8" data-aos="fade-down-left" data-aos-delay="300" data-aos-duration="650">
          <span class="service-icon mb-4"><i class="fas fa-building"></i></span>
          <h3 class="font-semibold mb-1.5">SMEs</h3>
          <p class="text-sm text-gray-400 leading-relaxed">Ready to modernize how you operate.</p>
        </div>
        <div class="glass p-7" data-aos="fade-up-right" data-aos-delay="450" data-aos-duration="650">
          <span class="service-icon mb-4"><i class="fas fa-city"></i></span>
          <h3 class="font-semibold mb-1.5">Enterprises</h3>
          <p class="text-sm text-gray-400 leading-relaxed">Replacing manual processes with systems built for how you work.</p>
        </div>
        <div class="glass p-7 mt-8" data-aos="fade-up-left" data-aos-delay="600" data-aos-duration="650">
          <span class="service-icon mb-4"><i class="fas fa-diagram-project"></i></span>
          <h3 class="font-semibold mb-1.5">Every stage</h3>
          <p class="text-sm text-gray-400 leading-relaxed">Same process and standard, scoped to your size.</p>
        </div>
      </div>
    </div>
  </div>
</section>

