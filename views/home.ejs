    </div>
  </div>
</section>

<script>
  // Pull the team from the CMS so this mirrors the admin panel (same source as /team).
  (() => {
    const wrap = document.getElementById("homeTeam");
    const FALLBACK = "<%= siteImages['team.fallback'] %>";
    const escape = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    // Only allow real image / link URLs into src and href attributes.
    const safeImg = (u) => (/^https?:\/\//i.test(String(u || "")) ? u : FALLBACK);
    const safeHref = (u) => (/^https?:\/\//i.test(String(u || "")) ? u : "");

    const socialLink = (url, icon, label) => {
      const href = safeHref(url);
      if (!href) return "";
      return `<a href="${escape(href)}" target="_blank" rel="noopener" aria-label="${label}"
        class="grid place-items-center w-8 h-8 rounded-lg bg-white/10 border border-white/20 text-white hover:bg-brand hover:border-brand transition">
        <i class="fab ${icon} text-xs"></i></a>`;
    };

    fetch("/api/team")
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(res.status))))
      .then((team) => {
        if (!team.length) {
          wrap.innerHTML =
            '<div class="glass p-10 text-center col-span-2 md:col-span-3 lg:col-span-4">' +
            '<i class="fas fa-users text-3xl text-gray-700 mb-3"></i>' +
            '<p class="text-gray-500">Team members will appear here — add them from the admin panel.</p></div>';
          return;
        }

        // Home page shows only the first 4; the full roster lives on /team.
        wrap.innerHTML = team.slice(0, 4).map((m, i) => {
          const s = m.social || {};
          const socials = [
            socialLink(s.linkedin, "fa-linkedin-in", "LinkedIn"),
            socialLink(s.twitter, "fa-twitter", "Twitter"),
            socialLink(s.github, "fa-github", "GitHub"),
          ].join("");
          return `
            <div class="glass overflow-hidden group text-center" data-aos="zoom-in" data-aos-delay="${i * 120}" data-aos-duration="600">
              <div class="relative h-56 overflow-hidden">
                <img src="${escape(safeImg(m.image))}" alt="${escape(m.name)}" loading="lazy"
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-ink-900/85 via-ink-900/10 to-transparent"></div>
                ${socials ? `<div class="absolute bottom-0 left-0 right-0 p-3 flex justify-center gap-2 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition">${socials}</div>` : ""}
              </div>
              <div class="p-5">
                <h3 class="font-bold">${escape(m.name)}</h3>
                <p class="text-sm text-brand font-medium">${escape(m.position || "Team Member")}</p>
              </div>
            </div>`;
        }).join("");
        // Cards were just injected -- let AOS animate them on scroll.
        if (window.AOS) AOS.refresh();
      })
      .catch(() => {
        wrap.innerHTML =
          '<div class="glass p-10 text-center col-span-2 md:col-span-3 lg:col-span-4">' +
          '<p class="text-gray-500">Team is unavailable right now.</p></div>';
      });
  })();
</script>

