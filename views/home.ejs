<script>
  // Pull the newest posts so the homepage reflects the CMS instead of hardcoded cards.
  (() => {
    const wrap = document.getElementById("homeBlogs");
    const escape = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    fetch("/api/blogs")
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(res.status))))
      .then((blogs) => {
        if (!blogs.length) {
          wrap.innerHTML =
            '<div class="glass p-10 text-center md:col-span-3"><i class="fas fa-feather text-3xl text-gray-700 mb-3"></i>' +
            '<p class="text-gray-500">No posts published yet — check back soon.</p></div>';
          return;
        }

        wrap.innerHTML = blogs.slice(0, 3).map((b) => {
          const date = b.createdAt
            ? new Date(b.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
            : "";
          const img = b.image || "<%= siteImages['blog.fallback'] %>";
          return `
            <a href="/blog/${encodeURIComponent(b.slug)}" class="glass overflow-hidden group block">
              <div class="h-44 overflow-hidden">
                <img src="${escape(img)}" alt="${escape(b.title)}" loading="lazy"
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
                  ${b.category ? `<span class="px-2.5 py-1 rounded-full bg-brand/10 border border-brand/25 text-brand font-medium">${escape(b.category)}</span>` : ""}
                  <span>${escape(date)}</span>
                </div>
                <h3 class="font-bold mb-2 group-hover:text-brand transition line-clamp-2">${escape(b.title)}</h3>
                <p class="text-sm text-gray-400 leading-relaxed line-clamp-2">${escape(b.excerpt || "")}</p>
              </div>
            </a>`;
        }).join("");
      })
      .catch(() => {
        wrap.innerHTML =
          '<div class="glass p-10 text-center md:col-span-3"><p class="text-gray-500">Posts are unavailable right now.</p></div>';
      });
  })();
</script>
