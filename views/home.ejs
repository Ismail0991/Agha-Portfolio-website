<!-- Landing-page interactions (AOS, scroll bar, back-to-top are provided globally by layout.ejs). -->
<script>
  // Interactive service cards: tilt toward the cursor and move a spotlight highlight.
  (() => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll(".svc-tilt").forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty("--mx", (px * 100) + "%");
        card.style.setProperty("--my", (py * 100) + "%");
        const rx = ((0.5 - py) * 7).toFixed(2);
        const ry = ((px - 0.5) * 9).toFixed(2);
        card.style.transform = "perspective(820px) rotateX(" + rx + "deg) rotateY(" + ry + "deg) translateY(-4px)";
      });
      card.addEventListener("mouseleave", () => { card.style.transform = ""; });
    });
  })();

  (() => {
    // Floating hero particles (skipped under reduced-motion).
    const host = document.getElementById("homeParticles");
    if (host && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const N = 18;
      let seed = 7;
      const rnd = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };
      for (let i = 0; i < N; i++) {
        const p = document.createElement("span");
        const size = 3 + rnd() * 5;
        p.style.left = (rnd() * 100) + "%";
        p.style.width = p.style.height = size + "px";
        p.style.opacity = String(0.2 + rnd() * 0.4);
        p.style.animationDuration = (9 + rnd() * 10) + "s";
        p.style.animationDelay = (rnd() * 8) + "s";
        host.appendChild(p);
      }
    }
  })();

  // Pull the newest posts so the homepage reflects the CMS instead of hardcoded cards.
  (() => {
    const wrap = document.getElementById("homeBlogs");
    const escape = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    fetch("/api/blogs")
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(res.status))))
      .then((blogs) => {
        if (!blogs.length) {
          wrap.innerHTML =
            '<div class="glass p-10 text-center md:col-span-3"><i class="fas fa-feather text-3xl text-gray-700 mb-3"></i>' +
            '<p class="text-gray-500">No posts published yet — check back soon.</p></div>';
          return;
        }

        wrap.innerHTML = blogs.slice(0, 3).map((b, i) => {
          const date = b.createdAt
            ? new Date(b.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
            : "";
          const img = b.image || "<%= siteImages['blog.fallback'] %>";
          return `
            <a href="/blog/${encodeURIComponent(b.slug)}" class="glass overflow-hidden group block"
               data-aos="fade-up" data-aos-delay="${i * 120}" data-aos-duration="650">
              <div class="h-44 overflow-hidden">
                <img src="${escape(img)}" alt="${escape(b.title)}" loading="lazy"
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
                  ${b.category ? `<span class="px-2.5 py-1 rounded-full bg-brand/10 border border-brand/25 text-brand font-medium">${escape(b.category)}</span>` : ""}
                  <span>${escape(date)}</span>
                </div>
                <h3 class="font-bold mb-2 group-hover:text-brand transition line-clamp-2">${escape(b.title)}</h3>
                <p class="text-sm text-gray-400 leading-relaxed line-clamp-2">${escape(b.excerpt || "")}</p>
              </div>
            </a>`;
        }).join("");
        // The cards were just injected, so let AOS pick them up for the scroll animation.
        if (window.AOS) AOS.refresh();
      })
      .catch(() => {
        wrap.innerHTML =
          '<div class="glass p-10 text-center md:col-span-3"><p class="text-gray-500">Posts are unavailable right now.</p></div>';
      });
  })();
</script>
