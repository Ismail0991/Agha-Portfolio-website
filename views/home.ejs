<style>
  /* ===== Landing-page hero visual + marquee (AOS, scroll bar and back-to-top are global in layout.ejs) ===== */

  /* Hero animated visual */
  .hv-wrap { position: relative; width: 100%; max-width: 440px; margin: 0 auto; aspect-ratio: 1 / 1; }
  .hv-glow {
    position: absolute; inset: 12%; border-radius: 50%;
    background: radial-gradient(circle, rgba(20,184,166,0.35), transparent 65%);
    filter: blur(30px); animation: hvGlow 5s ease-in-out infinite;
  }
  @keyframes hvGlow { 0%,100% { opacity: 0.55; transform: scale(1); } 50% { opacity: 0.9; transform: scale(1.08); } }

  .hv-orbit {
    position: absolute; border-radius: 50%; border: 1px dashed rgba(20,184,166,0.28);
    top: 50%; left: 50%; transform: translate(-50%, -50%);
  }
  .hv-orbit.o1 { width: 78%; height: 78%; animation: spin 22s linear infinite; }
  .hv-orbit.o2 { width: 100%; height: 100%; border-color: rgba(59,130,246,0.22); animation: spin 34s linear infinite reverse; }
  .hv-orbit.o1::after {
    content: ""; position: absolute; top: -5px; left: 50%; width: 10px; height: 10px;
    border-radius: 50%; background: var(--primary); box-shadow: 0 0 14px 3px rgba(20,184,166,0.7);
  }
  @keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }

  .hv-center {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 58%; display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center;
    animation: floatY 6s ease-in-out infinite;
  }
  .hv-center img { width: 62%; max-width: 118px; object-fit: contain; }
  .hv-wordmark { font-family: "Poppins", sans-serif; font-weight: 800; font-size: 1.1rem; line-height: 1; color: var(--text-strong); }
  .hv-wordmark span { color: var(--primary); }
  .hv-tag { font-size: 0.52rem; letter-spacing: 0.22em; font-weight: 600; color: var(--text-muted); }
  @keyframes floatY { 0%,100% { transform: translate(-50%, -50%) translateY(0); } 50% { transform: translate(-50%, -50%) translateY(-10px); } }

  .float-ic {
    position: absolute; width: 48px; height: 48px; display: grid; place-items: center;
    border-radius: 14px; font-size: 1.15rem; color: var(--primary);
    background: rgba(15,23,42,0.85); border: 1px solid rgba(20,184,166,0.3);
    box-shadow: 0 8px 24px -10px rgba(0,0,0,0.6); backdrop-filter: blur(6px);
    animation: floatIc 5s ease-in-out infinite;
  }
  .float-ic.b { color: var(--accent-blue); border-color: rgba(59,130,246,0.3); }
  .fi-1 { top: 2%;  left: 12%; animation-delay: 0s; }
  .fi-2 { top: 6%;  right: 6%;  animation-delay: 0.6s; }
  .fi-3 { top: 42%; right: -3%; animation-delay: 1.2s; }
  .fi-4 { bottom: 6%; right: 12%; animation-delay: 1.8s; }
  .fi-5 { bottom: 2%; left: 10%;  animation-delay: 2.4s; }
  .fi-6 { top: 40%; left: -3%;   animation-delay: 3s; }
  @keyframes floatIc { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }

  /* Hero particles */
  .home-particles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .home-particles span {
    position: absolute; bottom: -10px; width: 6px; height: 6px; border-radius: 50%;
    background: rgba(20,184,166,0.5); animation: particleRise linear infinite;
  }
  @keyframes particleRise {
    0% { transform: translateY(0) scale(1); opacity: 0; }
    10% { opacity: 0.8; }
    100% { transform: translateY(-90vh) scale(0.3); opacity: 0; }
  }

  /* Tagline marquee */
  .home-marquee {
    border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.02); overflow: hidden; padding: 1rem 0;
  }
  .home-marquee .track {
    display: inline-flex; gap: 3rem; white-space: nowrap; padding-left: 3rem;
    animation: marqueeMove 28s linear infinite; will-change: transform;
  }
  .home-marquee span {
    font-family: "Poppins", sans-serif; font-weight: 700; font-size: 1.05rem;
    letter-spacing: 0.12em; color: transparent; -webkit-text-stroke: 1px rgba(45,212,191,0.55);
  }
  .home-marquee span.solid { color: var(--primary); -webkit-text-stroke: 0; }
  @keyframes marqueeMove { to { transform: translateX(-50%); } }

  /* Title underline flourish */
  .title-underline {
    display: inline-block; height: 4px; width: 0; border-radius: 999px;
    background: linear-gradient(90deg, var(--primary), var(--accent-blue));
    animation: underlineGrow 1s ease forwards 0.4s;
  }
  @keyframes underlineGrow { to { width: 5.5rem; } }

  /* Interactive service cards: cursor-following spotlight + 3D tilt (transform set by JS). */
  .svc-tilt {
    position: relative; transform-style: preserve-3d;
    transition: transform 0.15s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }
  .svc-tilt::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 0;
    background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), rgba(20, 184, 166, 0.18), transparent 55%);
    opacity: 0; transition: opacity 0.3s ease;
  }
  .svc-tilt:hover::before { opacity: 1; }
  .svc-tilt > * { position: relative; z-index: 1; }
  .svc-tilt:hover { border-color: rgba(20, 184, 166, 0.55); box-shadow: 0 24px 48px -22px rgba(20, 184, 166, 0.45); }
  .svc-tilt .service-icon { transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .svc-tilt:hover .service-icon { transform: translateY(-4px) rotate(-8deg) scale(1.12); }

  /* About Us 3-image gallery collage (desktop): tall image left, two stacked right. */
  .about-gallery {
    position: relative; display: grid; gap: 0.9rem; height: 460px;
    grid-template-columns: 1.25fr 1fr; grid-template-rows: 1fr 1fr;
  }
  .about-gallery .g-img {
    border-radius: 1rem; overflow: hidden; border: 1px solid var(--border);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.55);
  }
  .about-gallery .g-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .about-gallery .g-img:hover img { transform: scale(1.06); }
  .about-gallery .g1 { grid-row: 1 / 3; }
  .about-badge {
    position: absolute; left: 50%; bottom: -1.25rem; transform: translateX(-50%); z-index: 5;
    display: inline-flex; align-items: center; gap: 0.6rem; white-space: nowrap; max-width: calc(100% - 1rem);
    padding: 0.7rem 1.1rem; border-radius: 0.85rem;
    background: var(--elevated); border: 1px solid var(--border); backdrop-filter: blur(10px);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
  }
  /* Mobile: full-width image on top, two side-by-side below -- landscape cells so images
     are not squished into tall/cropped shapes, and a smaller badge that stays on screen. */
  @media (max-width: 640px) {
    .about-gallery {
      height: auto; gap: 0.75rem; margin-bottom: 1.5rem;
      grid-template-columns: 1fr 1fr; grid-template-rows: 190px 140px;
    }
    .about-gallery .g1 { grid-row: 1 / 2; grid-column: 1 / 3; }
    .about-badge { padding: 0.5rem 0.85rem; gap: 0.5rem; }
    .about-badge .text-sm { font-size: 0.75rem; }
    .about-badge .service-icon { width: 2rem !important; height: 2rem !important; font-size: 0.85rem !important; }
  }

  /* Custom AOS animations: images start rotated ~30deg + offset in their direction,
     then settle straight. AOS toggles .aos-animate; layout's reduced-motion / no-AOS
     fallback forces transform:none, so a missing library leaves them straight. */
  [data-aos="atilt-r"], [data-aos="atilt-d"], [data-aos="atilt-l"] {
    opacity: 0; transition-property: transform, opacity;
  }
  [data-aos="atilt-r"] { transform: translateX(-15px) rotate(-30deg); }
  [data-aos="atilt-d"] { transform: translateY(-15px) rotate(30deg); }
  [data-aos="atilt-l"] { transform: translateX(15px) rotate(-30deg); }
  [data-aos="atilt-r"].aos-animate,
  [data-aos="atilt-d"].aos-animate,
  [data-aos="atilt-l"].aos-animate { opacity: 1; transform: translate(0, 0) rotate(0); }

  @media (prefers-reduced-motion: reduce) {
    .hv-glow, .hv-orbit, .hv-center, .float-ic, .home-particles span,
    .home-marquee .track, .title-underline { animation: none !important; }
    .hv-orbit.o1, .hv-orbit.o2 { transform: translate(-50%, -50%); }
    .svc-tilt::before { display: none; }
    .svc-tilt:hover .service-icon { transform: none; }
    .about-gallery .g-img:hover img { transform: none; }
  }
</style>

<!-- ============================ HERO ============================ -->
<section class="hero-section relative overflow-hidden">
  <div class="absolute inset-0 grid-bg pointer-events-none"></div>
  <div class="home-particles" id="homeParticles"></div>

  <div class="relative max-w-7xl mx-auto px-4 pt-20 pb-20 lg:pt-28 lg:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- On mobile the logo + orbit visual sits above the headline; side-by-side on desktop. -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div class="eyebrow mb-6" data-aos="fade-down" data-aos-duration="650">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
          <%= content['hero.eyebrow'] %>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold leading-[1.1] mb-3" data-aos="fade-up" data-aos-duration="750">
          <%= content['hero.titlePre'] %> <span class="gradient-text"><%= content['hero.titleHighlight'] %></span><%= content['hero.titlePost'] %>
        </h1>
        <span class="title-underline mb-6"></span>

        <p class="text-lg text-gray-400 leading-relaxed max-w-xl mb-9 mt-6" data-aos="fade-up" data-aos-delay="100" data-aos-duration="650">
          <%= content['hero.desc'] %>
        </p>

        <div class="flex flex-wrap gap-3 mb-14" data-aos="fade-up" data-aos-delay="200" data-aos-duration="650">
          <a href="<%= content['hero.primaryLink'] %>" class="primary-btn">
            <%= content['hero.primaryLabel'] %> <i class="fas fa-arrow-right text-xs"></i>
          </a>
          <a href="<%= content['hero.secondaryLink'] %>" class="ghost-btn">
            <i class="fas fa-layer-group text-xs"></i> <%= content['hero.secondaryLabel'] %>
          </a>
        </div>

        <div class="grid grid-cols-3 gap-6 max-w-lg" data-aos="fade-up" data-aos-delay="300" data-aos-duration="650">
          <div>
            <h3 class="text-3xl font-bold text-brand font-display" data-count="<%= content['hero.stat1Value'] %>">0</h3>
            <p class="text-sm text-gray-500 mt-1"><%= content['hero.stat1Label'] %></p>
          </div>
          <div class="border-x border-white/10 px-6">
            <h3 class="text-3xl font-bold text-brand font-display" data-count="<%= content['hero.stat2Value'] %>">0</h3>
            <p class="text-sm text-gray-500 mt-1"><%= content['hero.stat2Label'] %></p>
          </div>
          <div>
            <h3 class="text-3xl font-bold text-brand font-display" data-count="<%= content['hero.stat3Value'] %>">0</h3>
            <p class="text-sm text-gray-500 mt-1"><%= content['hero.stat3Label'] %></p>
          </div>
        </div>
      </div>

      <!-- Animated hero visual: orbiting rings + floating tech icons around the Aghaz mark. -->
      <div class="lg:col-span-5 order-1 lg:order-2" data-aos="zoom-in" data-aos-delay="150" data-aos-duration="650">
        <div class="hv-wrap">
          <div class="hv-glow"></div>
          <div class="hv-orbit o1"></div>
          <div class="hv-orbit o2"></div>
          <div class="hv-center">
            <img src="<%= content['brand.logo'] %>" alt="<%= content['brand.namePrimary'] %> <%= content['brand.nameAccent'] %>">
            <div class="hv-wordmark"><%= content['brand.namePrimary'] %> <span><%= content['brand.nameAccent'] %></span></div>
            <div class="hv-tag">START · GROW · SUCCEED</div>
          </div>
          <div class="float-ic fi-1"><i class="fab fa-react"></i></div>
          <div class="float-ic b fi-2"><i class="fab fa-node-js"></i></div>
          <div class="float-ic fi-3"><i class="fab fa-js"></i></div>
          <div class="float-ic b fi-4"><i class="fab fa-figma"></i></div>
          <div class="float-ic fi-5"><i class="fab fa-aws"></i></div>
          <div class="float-ic b fi-6"><i class="fab fa-google"></i></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tagline marquee -->
  <div class="home-marquee" aria-hidden="true">
    <div class="track">
      <span class="solid">✦ START</span><span>GROW</span><span class="solid">✦ SUCCEED</span><span>INNOVATE</span><span class="solid">✦ DESIGN</span><span>DEVELOP</span>
      <span class="solid">✦ START</span><span>GROW</span><span class="solid">✦ SUCCEED</span><span>INNOVATE</span><span class="solid">✦ DESIGN</span><span>DEVELOP</span>
    </div>
  </div>
</section>

<!-- ============================ ABOUT US ============================ -->
<section id="about" class="py-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-16 items-center">
      <!-- 3-image collage: each image reveals from a different direction, staggered. -->
      <div class="about-gallery">
        <div class="g-img g1" data-aos="atilt-r" data-aos-delay="0" data-aos-duration="700">
          <img src="<%= siteImages['about.story'] %>" alt="The Aghaz Tech team at work" loading="lazy">
        </div>
        <div class="g-img g2" data-aos="atilt-d" data-aos-delay="150" data-aos-duration="700">
          <img src="<%= siteImages['about.culture'] %>" alt="Collaborating on a project" loading="lazy">
        </div>
        <div class="g-img g3" data-aos="atilt-l" data-aos-delay="300" data-aos-duration="700">
          <img src="<%= siteImages['home.hero'] %>" alt="Building digital solutions" loading="lazy">
        </div>
        <div class="about-badge" data-aos="zoom-in" data-aos-delay="450" data-aos-duration="600">
