            <div>
              <h4 class="font-semibold mb-1"><%= content['about.feat1Title'] %></h4>
              <p class="text-sm text-gray-400 leading-relaxed"><%= content['about.feat1Text'] %></p>
            </div>
          </div>
          <div class="flex gap-4" data-aos="fade-left" data-aos-delay="850" data-aos-duration="600">
            <span class="service-icon shrink-0"><i class="fas <%= content['about.feat2Icon'] %>"></i></span>
            <div>
              <h4 class="font-semibold mb-1"><%= content['about.feat2Title'] %></h4>
              <p class="text-sm text-gray-400 leading-relaxed"><%= content['about.feat2Text'] %></p>
            </div>
          </div>
          <div class="flex gap-4" data-aos="fade-left" data-aos-delay="1000" data-aos-duration="600">
            <span class="service-icon shrink-0"><i class="fas <%= content['about.feat3Icon'] %>"></i></span>
            <div>
              <h4 class="font-semibold mb-1"><%= content['about.feat3Title'] %></h4>
              <p class="text-sm text-gray-400 leading-relaxed"><%= content['about.feat3Text'] %></p>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3" data-aos="zoom-in" data-aos-delay="1200" data-aos-duration="600">
          <a href="<%= content['about.primaryLink'] %>" class="primary-btn"><%= content['about.primaryLabel'] %> <i class="fas fa-arrow-right text-xs"></i></a>
          <a href="<%= content['about.secondaryLink'] %>" class="ghost-btn"><i class="fas fa-users text-xs"></i> <%= content['about.secondaryLabel'] %></a>
        </div>
