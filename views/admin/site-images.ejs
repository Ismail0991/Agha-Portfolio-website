<!DOCTYPE html>
<html lang="en">
<head>
  <script>document.documentElement.setAttribute("data-theme","<%= typeof siteTheme !== 'undefined' ? siteTheme : 'dark' %>");</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Site Images - Aghaz Tech Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: { 900: "#0A0F1C", 800: "#0F172A", 700: "#1E293B", 600: "#293548" },
            brand: { DEFAULT: "#14B8A6", dark: "#0F766E", light: "#2DD4BF", blue: "#3B82F6" },
          },
          fontFamily: {
            display: ["Poppins", "system-ui", "sans-serif"],
            sans: ["Inter", "system-ui", "sans-serif"],
          },
        },
      },
    };
  </script>
  <style>
    /* ===== Theme tokens ===== brand teal is shared; everything else flips. */
    :root, :root[data-theme="dark"] {
      --primary: #14b8a6;
      --primary-dark: #0f766e;
      --accent-blue: #3b82f6;
      --bg: #0a0f1c;
      --text: #cbd5e1;
      --text-strong: #ffffff;
      --text-muted: #94a3b8;
      --surface: rgba(255, 255, 255, 0.035);
      --surface-2: rgba(255, 255, 255, 0.06);
      --border: rgba(255, 255, 255, 0.09);
      --brand-text: #2dd4bf;
      --nav-bg: rgba(10, 15, 28, 0.7);
      --elevated: rgba(15, 23, 42, 0.95);
      --grid-line: rgba(255, 255, 255, 0.035);
      --track: #0a0f1c;
      --thumb: #29374d;
      --thumb-hover: #3a4a63;
      --glow-1: rgba(20, 184, 166, 0.14);
      --glow-2: rgba(59, 130, 246, 0.08);
    }
    :root[data-theme="light"] {
      --bg: #f1f5f9;
      --text: #475569;
      --text-strong: #0f172a;
      --text-muted: #64748b;
      --surface: rgba(15, 23, 42, 0.035);
      --surface-2: rgba(15, 23, 42, 0.07);
      --border: rgba(15, 23, 42, 0.12);
      --brand-text: #0f766e;
      --nav-bg: rgba(241, 245, 249, 0.82);
      --elevated: rgba(255, 255, 255, 0.97);
      --grid-line: rgba(15, 23, 42, 0.05);
      --track: #e2e8f0;
      --thumb: #cbd5e1;
      --thumb-hover: #94a3b8;
      --glow-1: rgba(20, 184, 166, 0.1);
      --glow-2: rgba(59, 130, 246, 0.07);
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: "Inter", system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      transition: background 0.3s ease, color 0.3s ease;
    }

    h1, h2, h3, h4 { font-family: "Poppins", system-ui, sans-serif; letter-spacing: -0.02em; color: var(--text-strong); }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(60rem 40rem at 75% -10%, var(--glow-1), transparent 60%),
        radial-gradient(45rem 35rem at 5% 15%, var(--glow-2), transparent 55%);
    }
    body > * { position: relative; z-index: 1; }

    .primary-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: linear-gradient(180deg, var(--primary), var(--primary-dark));
      color: #fff;
      padding: 0.8rem 1.6rem;
      border-radius: 0.75rem;
      font-weight: 600;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 24px -8px rgba(20, 184, 166, 0.65);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      cursor: pointer;
    }
    .primary-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 32px -8px rgba(20, 184, 166, 0.8);
      filter: brightness(1.06);
    }

    .ghost-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.8rem 1.6rem;
      border-radius: 0.75rem;
      font-weight: 600;
      color: var(--text-strong);
      border: 1px solid var(--border);
      background: var(--surface);
      backdrop-filter: blur(8px);
      transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
      cursor: pointer;
    }
    .ghost-btn:hover {
      background: var(--surface-2);
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .glass {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1rem;
      backdrop-filter: blur(10px);
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .member-card:hover {
      transform: translateY(-4px);
      border-color: rgba(20, 184, 166, 0.4);
      background: var(--surface-2);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary);
      background: rgba(20, 184, 166, 0.1);
      border: 1px solid rgba(20, 184, 166, 0.25);
    }

    .gradient-text {
      background: linear-gradient(120deg, var(--text-strong) 15%, var(--primary) 55%, #2dd4bf 90%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .field {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.7rem;
      padding: 0.75rem 1rem;
      color: var(--text-strong);
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .field::placeholder { color: var(--text-muted); }
    .field:focus {
      outline: none;
      border-color: var(--primary);
      background: var(--surface-2);
    }

    /* --- Admin shell --- */
    .admin-sidebar {
      background: var(--elevated);
      border-right: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.7rem 0.9rem;
      border-radius: 0.7rem;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-muted);
      border: 1px solid transparent;
      transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .nav-item i { width: 1.1rem; text-align: center; font-size: 0.85rem; }
    .nav-item:hover { color: var(--text-strong); background: var(--surface); }
    .nav-item.active {
      color: var(--text-strong);
      font-weight: 600;
      background: rgba(20, 184, 166, 0.12);
      border-color: rgba(20, 184, 166, 0.3);
    }
    .nav-item.active i { color: var(--primary); }

    .icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.45rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-muted);
      transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      cursor: pointer;
    }
    .icon-btn:hover { color: var(--text-strong); background: var(--surface-2); border-color: var(--border); }
    .icon-btn.danger:hover { color: #fff; background: rgba(20, 184, 166, 0.85); border-color: rgba(20, 184, 166, 0.9); }

    ::selection { background: rgba(20, 184, 166, 0.35); }
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: var(--track); }
    ::-webkit-scrollbar-thumb { background: var(--thumb); border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--thumb-hover); }

    .slot-card { display: grid; grid-template-columns: 200px 1fr; gap: 1.25rem; }
    @media (max-width: 640px) { .slot-card { grid-template-columns: 1fr; } }
    .drop {
      border: 1px dashed var(--border);
      border-radius: 0.75rem;
      transition: border-color .2s ease, background .2s ease;
    }
    .drop.dragover { border-color: var(--primary); background: rgba(20, 184, 166,0.07); }

    /* Theme toggle button */
    .theme-toggle {
      display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px;
      color: var(--text-strong); border: 1px solid var(--border); background: var(--surface);
      cursor: pointer; transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .theme-toggle:hover { background: var(--surface-2); border-color: var(--primary); color: var(--primary); }

    /* ===== Light-mode overrides for hardcoded Tailwind utilities used across pages ===== */
    :root[data-theme="light"] .text-white { color: var(--text-strong) !important; }
    :root[data-theme="light"] .text-gray-300,
    :root[data-theme="light"] .text-gray-400 { color: var(--text) !important; }
    :root[data-theme="light"] .text-gray-500,
    :root[data-theme="light"] .text-gray-600 { color: var(--text-muted) !important; }
    :root[data-theme="light"] .text-gray-700 { color: #cbd5e1 !important; }
    :root[data-theme="light"] .text-brand { color: var(--brand-text) !important; }
    :root[data-theme="light"] .border-white\/10,
    :root[data-theme="light"] .border-white\/5 { border-color: var(--border) !important; }
    :root[data-theme="light"] .bg-white\/\[0\.02\],
    :root[data-theme="light"] .bg-white\/\[0\.03\],
    :root[data-theme="light"] .bg-white\/\[0\.04\],
    :root[data-theme="light"] .bg-white\/\[0\.05\] { background-color: rgba(15, 23, 42, 0.04) !important; }
    :root[data-theme="light"] .bg-white\/\[0\.06\] { background-color: rgba(15, 23, 42, 0.06) !important; }
    :root[data-theme="light"] .bg-white\/5 { background-color: rgba(15, 23, 42, 0.05) !important; }
    :root[data-theme="light"] .bg-white\/10 { background-color: rgba(15, 23, 42, 0.1) !important; }
    :root[data-theme="light"] .bg-ink-800 { background-color: #e2e8f0 !important; }
    :root[data-theme="light"] .bg-ink-900\/90 { background-color: var(--nav-bg) !important; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      [data-aos] { opacity: 1 !important; transform: none !important; transition: none !important; }
    }
  </style>
</head>
<body class="font-sans">
  <div class="flex min-h-screen">
    <aside class="admin-sidebar hidden lg:flex lg:flex-col w-64 shrink-0 sticky top-0 h-screen">
      <div class="p-6 border-b border-white/10">
        <a href="/" class="flex items-center gap-2.5 text-xl font-bold font-display text-white">
          <img src="/images/aghaz-mark.png" alt="Aghaz Tech" class="w-9 h-9 object-contain shrink-0">
          Aghaz Tech
        </a>
        <p class="text-xs text-gray-500 mt-2 ml-0.5">Admin Panel</p>
      </div>

      <nav class="flex-1 p-4 space-y-1.5">
        <p class="text-[10px] uppercase tracking-[0.16em] text-gray-600 font-semibold px-2 pb-2">Manage</p>
        <a href="/admin/dashboard" class="nav-item"><i class="fas fa-chart-line"></i> Dashboard</a>
        <a href="/admin/blogs" class="nav-item"><i class="fas fa-newspaper"></i> Manage Blogs</a>
        <a href="/admin/team" class="nav-item"><i class="fas fa-users"></i> Manage Team</a>
        <a href="/admin/site-images" class="nav-item active"><i class="fas fa-images"></i> Site Images</a>
        <a href="/admin/landing" class="nav-item"><i class="fas fa-sliders"></i> Landing Page</a>
      </nav>

      <div class="p-4 border-t border-white/10 space-y-1.5">
        <a href="/" target="_blank" rel="noopener" class="nav-item">
          <i class="fas fa-arrow-up-right-from-square"></i> View Site
        </a>
        <div class="flex items-center gap-1.5">
          <a href="/api/auth/logout" class="nav-item hover:!text-brand-light flex-1">
            <i class="fas fa-sign-out-alt"></i> Logout
          </a>
          <button type="button" class="theme-toggle shrink-0" data-theme-toggle aria-label="Toggle light and dark mode"><i class="fas fa-sun"></i></button>
        </div>
      </div>
    </aside>

    <div class="flex-1 min-w-0">
      <header class="lg:hidden sticky top-0 z-20 flex items-center justify-between gap-3 px-4 py-3 border-b border-white/10 bg-ink-900/90 backdrop-blur">
        <a href="/" class="flex items-center gap-2 font-bold font-display text-white">
          <img src="/images/aghaz-mark.png" alt="Aghaz Tech" class="w-8 h-8 object-contain shrink-0">
          Aghaz Tech
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href="/admin/dashboard" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" title="Dashboard"><i class="fas fa-chart-line"></i></a>
          <a href="/admin/blogs" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" title="Manage Blogs"><i class="fas fa-newspaper"></i></a>
          <a href="/admin/team" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" title="Manage Team"><i class="fas fa-users"></i></a>
          <a href="/admin/site-images" class="px-2.5 py-1.5 rounded-lg text-brand font-semibold" title="Site Images"><i class="fas fa-images"></i></a>
          <a href="/admin/landing" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" title="Landing Page"><i class="fas fa-sliders"></i></a>
          <button type="button" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" data-theme-toggle aria-label="Toggle light and dark mode"><i class="fas fa-sun"></i></button>
          <a href="/api/auth/logout" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-brand" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
        </nav>
      </header>

      <main class="p-5 sm:p-8 max-w-5xl">
        <div class="mb-8" data-aos="fade-up">
          <p class="text-xs text-gray-500 mb-2">
            <a href="/admin/dashboard" class="hover:text-brand">Dashboard</a>
            <span class="mx-1.5 text-gray-700">/</span>
            <span class="text-gray-400">Site Images</span>
          </p>
          <h1 class="text-2xl sm:text-3xl font-bold mb-2">Site Images</h1>
          <p class="text-sm text-gray-500 max-w-2xl">
            Replace the fixed images used across the public site. Uploads go to Cloudinary
            and take effect immediately &mdash; no code change or redeploy needed.
          </p>
        </div>

        <div id="message" class="hidden mb-6 p-4 rounded-xl text-sm"></div>

        <div id="slots" class="space-y-4" data-aos="fade-up" data-aos-delay="80">
          <div class="glass p-6 animate-pulse"><div class="h-32 bg-white/5 rounded-lg"></div></div>
          <div class="glass p-6 animate-pulse"><div class="h-32 bg-white/5 rounded-lg"></div></div>
        </div>
      </main>
    </div>
  </div>

  <script>
    (() => {
      const wrap = document.getElementById("slots");
      const messageDiv = document.getElementById("message");

      const escape = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

      // Escaping alone does not stop javascript: URLs inside src/href.
      const safeUrl = (u) => {
        const s = String(u || "").trim();
        return /^https?:\/\//i.test(s) ? s : "";
      };

      const notify = (text, ok) => {
        messageDiv.textContent = text;
        messageDiv.className = ok
          ? "mb-6 p-4 rounded-xl text-sm bg-green-500/10 border border-green-500/30 text-green-300"
          : "mb-6 p-4 rounded-xl text-sm bg-brand/10 border border-brand/30 text-brand-light";
        messageDiv.classList.remove("hidden");
        window.scrollTo({ top: 0, behavior: "smooth" });
        setTimeout(() => messageDiv.classList.add("hidden"), 4000);
      };

      const wire = (card) => {
        const key = card.dataset.key;
        const input = card.querySelector("[data-file]");
        const drop = card.querySelector("[data-drop]");
        const status = card.querySelector("[data-status]");
        const preview = card.querySelector("[data-preview]");
        const resetBtn = card.querySelector("[data-reset]");

        const upload = async (file) => {
          if (!file) return;
          status.textContent = "Uploading...";

          try {
            const form = new FormData();
            form.append("image", file);

            const up = await fetch("/api/upload", { method: "POST", body: form });
            const uploaded = await up.json();
            if (!up.ok) throw new Error(uploaded.message || "Upload failed");

            const save = await fetch("/api/site/images/" + encodeURIComponent(key), {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ url: uploaded.url, publicId: uploaded.publicId }),
            });
            const saved = await save.json();
            if (!save.ok) throw new Error(saved.message || "Could not save image");

            preview.src = uploaded.url;
            preview.style.opacity = 1;
            status.textContent = "";
            notify("Image updated. Refresh the site to see it live.", true);
            load();
          } catch (error) {
            status.textContent = "";
            notify(error.message, false);
          }
        };

        input.addEventListener("change", (e) => upload(e.target.files[0]));

        ["dragenter", "dragover"].forEach((ev) =>
          drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add("dragover"); }));
        ["dragleave", "drop"].forEach((ev) =>
          drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove("dragover"); }));
        drop.addEventListener("drop", (e) => upload(e.dataTransfer.files[0]));

        if (resetBtn && !resetBtn.disabled) {
          resetBtn.addEventListener("click", async () => {
            if (!confirm("Reset this image back to the built-in default?")) return;
            try {
              const res = await fetch("/api/site/images/" + encodeURIComponent(key), { method: "DELETE" });
              if (!res.ok) throw new Error((await res.json()).message || "Reset failed");
              notify("Image reset to default.", true);
              load();
            } catch (error) {
              notify(error.message, false);
            }
          });
        }
      };

      const render = (slots) => {
        wrap.innerHTML = slots.map((s) => `
          <div class="glass p-6 slot-card" data-key="${escape(s.key)}">
            <div>
              <div class="rounded-lg overflow-hidden border border-white/10 bg-ink-800 aspect-[4/3]">
                <img src="${escape(safeUrl(s.url))}" alt="${escape(s.label)}"
                     class="w-full h-full object-cover" data-preview
                     onerror="this.style.opacity=0.2">
              </div>
              <p class="text-[11px] text-gray-600 mt-2 text-center">
                ${s.isCustom ? '<span class="text-green-400">Custom</span>' : "Using default"}
              </p>
            </div>

            <div class="min-w-0">
              <h3 class="font-semibold mb-1">${escape(s.label)}</h3>
              <p class="text-sm text-gray-500 mb-4">${escape(s.description)}</p>

              <label class="drop grid place-items-center py-6 px-4 cursor-pointer text-center block" data-drop>
                <input type="file" accept="image/*" class="hidden" data-file>
                <i class="fas fa-cloud-arrow-up text-xl text-gray-600 mb-2"></i>
                <span class="text-sm text-gray-400">Drop an image or <span class="text-brand font-semibold">browse</span></span>
                <span class="block text-[11px] text-gray-600 mt-1">JPEG, PNG, WebP, GIF or AVIF &middot; max 8MB</span>
              </label>

              <div class="flex flex-wrap items-center gap-2 mt-4">
                <button type="button" class="icon-btn" data-reset ${s.isCustom ? "" : 'disabled style="opacity:.4"'}>
                  <i class="fas fa-rotate-left"></i> Reset to default
                </button>
                <a href="${escape(safeUrl(s.url))}" target="_blank" rel="noopener" class="icon-btn">
                  <i class="fas fa-arrow-up-right-from-square"></i> Open full size
                </a>
                <span class="text-xs text-gray-600 ml-auto" data-status></span>
              </div>
            </div>
          </div>
        `).join("");

        wrap.querySelectorAll("[data-key]").forEach(wire);
      };

      const load = () => {
        fetch("/api/site/images/detailed")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error("Could not load images"))))
          .then(render)
          .catch((error) => {
            wrap.innerHTML = '<div class="glass p-10 text-center text-gray-500">' + escape(error.message) + "</div>";
          });
      };

      load();
    })();
  </script>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    // ----- Theme toggle -----
    (() => {
      const root = document.documentElement;
      const syncIcons = (t) => {
        document.querySelectorAll("[data-theme-toggle] i").forEach((ic) => {
          ic.className = t === "light" ? "fas fa-moon" : "fas fa-sun";
        });
      };
      const apply = (t) => {
        root.setAttribute("data-theme", t);
        fetch("/api/site/theme", { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ theme: t }) }).catch(() => {});
        syncIcons(t);
        if (window.AOS) AOS.refresh();
      };
      syncIcons(root.getAttribute("data-theme"));
      document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          apply(root.getAttribute("data-theme") === "light" ? "dark" : "light");
        });
      });
    })();

    // ----- AOS scroll animations (replay on scroll), with a fail-safe -----
    (() => {
      const revealAll = () => {
        const s = document.createElement("style");
        s.textContent = "[data-aos]{opacity:1 !important;transform:none !important;}";
        document.head.appendChild(s);
      };
      try {
        if (window.AOS) {
          AOS.init({ duration: 700, once: false, mirror: true, offset: 80, easing: "ease-out-cubic" });
        } else { revealAll(); }
      } catch (e) { revealAll(); }
      setTimeout(() => { if (!window.AOS) revealAll(); }, 2500);
    })();
  </script>
</body>
</html>
