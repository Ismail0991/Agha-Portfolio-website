<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - DigitalHub</title>
  <meta name="robots" content="noindex, nofollow">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: { 900: "#07070b", 800: "#0d0d14", 700: "#14141d", 600: "#1c1c28" },
            brand: { DEFAULT: "#ef4444", dark: "#dc2626", light: "#f87171" },
          },
          fontFamily: {
            display: ["Sora", "system-ui", "sans-serif"],
            sans: ["Inter", "system-ui", "sans-serif"],
          },
        },
      },
    };
  </script>
  <style>
    :root {
      --primary: #ef4444;
      --primary-dark: #dc2626;
      --ink: #07070b;
      --surface: rgba(255, 255, 255, 0.035);
      --border: rgba(255, 255, 255, 0.09);
    }

    body {
      background: var(--ink);
      color: #e7e7ea;
      font-family: "Inter", system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 { font-family: "Sora", system-ui, sans-serif; letter-spacing: -0.02em; }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(60rem 40rem at 75% -10%, rgba(239, 68, 68, 0.13), transparent 60%),
        radial-gradient(45rem 35rem at 5% 15%, rgba(239, 68, 68, 0.06), transparent 55%);
    }
    body > * { position: relative; z-index: 1; }

    .primary-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: linear-gradient(180deg, var(--primary), var(--primary-dark));
      color: #fff;
      padding: 0.8rem 1.6rem;
      border-radius: 0.75rem;
      font-weight: 600;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 24px -8px rgba(239, 68, 68, 0.65);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      cursor: pointer;
    }
    .primary-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 32px -8px rgba(239, 68, 68, 0.8);
      filter: brightness(1.06);
    }

    .ghost-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.8rem 1.6rem;
      border-radius: 0.75rem;
      font-weight: 600;
      color: #fff;
      border: 1px solid var(--border);
      background: var(--surface);
      backdrop-filter: blur(8px);
      transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
      cursor: pointer;
    }
    .ghost-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.22);
      transform: translateY(-2px);
    }

    .glass {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1rem;
      backdrop-filter: blur(10px);
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      border-color: rgba(239, 68, 68, 0.4);
      background: rgba(255, 255, 255, 0.06);
    }

    .service-icon {
      width: 3rem;
      height: 3rem;
      border-radius: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      font-size: 1.15rem;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.28);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary);
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .gradient-text {
      background: linear-gradient(120deg, #fff 15%, var(--primary) 55%, #fca5a5 90%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .field {
      width: 100%;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 0.7rem;
      padding: 0.75rem 1rem;
      color: #fff;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .field::placeholder { color: rgba(255, 255, 255, 0.35); }
    .field:focus {
      outline: none;
      border-color: var(--primary);
      background: rgba(255, 255, 255, 0.07);
    }

    /* --- Admin shell --- */
    .admin-sidebar {
      background: rgba(9, 9, 14, 0.75);
      border-right: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.7rem 0.9rem;
      border-radius: 0.7rem;
      font-size: 0.9rem;
      font-weight: 500;
      color: #9ca3af;
      border: 1px solid transparent;
      transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .nav-item i { width: 1.1rem; text-align: center; font-size: 0.85rem; }
    .nav-item:hover { color: #fff; background: rgba(255, 255, 255, 0.05); }
    .nav-item.active {
      color: #fff;
      font-weight: 600;
      background: rgba(239, 68, 68, 0.12);
      border-color: rgba(239, 68, 68, 0.3);
    }
    .nav-item.active i { color: var(--primary); }

    .grid-bg {
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 40%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 40%, transparent 100%);
    }

    ::selection { background: rgba(239, 68, 68, 0.35); }
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: #0b0b12; }
    ::-webkit-scrollbar-thumb { background: #2a2a38; border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: #3a3a4d; }
  </style>
</head>
<body class="font-sans">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="admin-sidebar hidden lg:flex lg:flex-col w-64 shrink-0 sticky top-0 h-screen">
      <div class="p-6 border-b border-white/10">
        <a href="/" class="flex items-center gap-2.5 text-xl font-bold font-display text-white">
          <span class="grid place-items-center w-9 h-9 rounded-lg bg-brand/15 border border-brand/30 text-brand text-sm">
            <i class="fas fa-rocket"></i>
          </span>
          DigitalHub
        </a>
        <p class="text-xs text-gray-500 mt-2 ml-0.5">Admin Panel</p>
      </div>

      <nav class="flex-1 p-4 space-y-1.5">
        <p class="text-[10px] uppercase tracking-[0.16em] text-gray-600 font-semibold px-2 pb-2">Manage</p>
        <a href="/admin/dashboard" class="nav-item active">
          <i class="fas fa-chart-line"></i> Dashboard
        </a>
        <a href="/admin/blogs" class="nav-item">
          <i class="fas fa-newspaper"></i> Manage Blogs
        </a>
        <a href="/admin/team" class="nav-item">
          <i class="fas fa-users"></i> Manage Team
        </a>
        <a href="/admin/site-images" class="nav-item"><i class="fas fa-images"></i> Site Images</a>
      </nav>

      <div class="p-4 border-t border-white/10 space-y-1.5">
        <a href="/" target="_blank" rel="noopener" class="nav-item">
          <i class="fas fa-arrow-up-right-from-square"></i> View Site
        </a>
        <a href="/api/auth/logout" class="nav-item hover:!text-brand-light">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 min-w-0">
      <!-- Mobile top bar -->
      <header class="lg:hidden sticky top-0 z-20 flex items-center justify-between gap-3 px-4 py-3 border-b border-white/10 bg-ink-900/90 backdrop-blur">
        <a href="/" class="flex items-center gap-2 font-bold font-display text-white">
          <span class="grid place-items-center w-8 h-8 rounded-lg bg-brand/15 border border-brand/30 text-brand text-xs">
            <i class="fas fa-rocket"></i>
          </span>
          DigitalHub
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href="/admin/dashboard" class="px-2.5 py-1.5 rounded-lg text-brand font-semibold" title="Dashboard"><i class="fas fa-chart-line"></i></a>
          <a href="/admin/blogs" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" title="Manage Blogs"><i class="fas fa-newspaper"></i></a>
          <a href="/admin/team" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" title="Manage Team"><i class="fas fa-users"></i></a>
          <a href="/admin/site-images" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white" title="Site Images"><i class="fas fa-images"></i></a>
          <a href="/api/auth/logout" class="px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-brand" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
        </nav>
      </header>

      <main class="p-5 sm:p-8 max-w-7xl">
        <div class="mb-8">
          <div class="eyebrow mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
            Overview
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold mb-2">
            Welcome back, <span class="gradient-text">Admin</span>
          </h1>
          <p class="text-gray-400">Everything happening across your content at a glance.</p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
          <div class="glass stat-card p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-xs uppercase tracking-[0.12em] text-gray-500 font-semibold mb-3">Total Blogs</p>
                <p class="text-3xl font-bold font-display text-white" id="blogCount">0</p>
              </div>
              <span class="service-icon shrink-0"><i class="fas fa-newspaper"></i></span>
            </div>
            <p class="text-xs text-gray-600 mt-4 pt-4 border-t border-white/10">
              <i class="fas fa-layer-group mr-1.5"></i> Published &amp; drafts
            </p>
          </div>

          <div class="glass stat-card p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-xs uppercase tracking-[0.12em] text-gray-500 font-semibold mb-3">Team Members</p>
                <p class="text-3xl font-bold font-display text-white" id="teamCount">0</p>
              </div>
              <span class="service-icon shrink-0"><i class="fas fa-users"></i></span>
            </div>
            <p class="text-xs text-gray-600 mt-4 pt-4 border-t border-white/10">
              <i class="fas fa-id-badge mr-1.5"></i> Live on the about page
            </p>
          </div>

          <div class="glass stat-card p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-xs uppercase tracking-[0.12em] text-gray-500 font-semibold mb-3">Total Views</p>
                <p class="text-3xl font-bold font-display text-white" id="totalViews">0</p>
              </div>
              <span class="service-icon shrink-0"><i class="fas fa-eye"></i></span>
            </div>
            <p class="text-xs text-gray-600 mt-4 pt-4 border-t border-white/10">
              <i class="fas fa-chart-simple mr-1.5"></i> Across all posts
            </p>
          </div>

          <div class="glass stat-card p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-xs uppercase tracking-[0.12em] text-gray-500 font-semibold mb-3">Last Update</p>
                <p class="text-2xl font-bold font-display text-white truncate" id="lastUpdate">Today</p>
              </div>
              <span class="service-icon shrink-0"><i class="fas fa-clock"></i></span>
            </div>
            <p class="text-xs text-gray-600 mt-4 pt-4 border-t border-white/10">
              <i class="fas fa-rotate mr-1.5"></i> Most recent post
            </p>
          </div>
        </div>

        <!-- Panels -->
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-5">
          <section class="glass p-6 lg:col-span-2">
            <h2 class="text-lg font-bold mb-1">Quick Actions</h2>
            <p class="text-sm text-gray-500 mb-6">Jump straight into the work.</p>

            <div class="space-y-3">
              <a href="/admin/blogs/new" class="primary-btn w-full !py-2.5">
                <i class="fas fa-plus text-xs"></i> Create New Blog
              </a>
              <a href="/admin/team/new" class="ghost-btn w-full !py-2.5">
                <i class="fas fa-user-plus text-xs"></i> Add Team Member
              </a>
              <a href="/admin/blogs" class="ghost-btn w-full !py-2.5">
                <i class="fas fa-list text-xs"></i> View All Blogs
              </a>
              <a href="/admin/team" class="ghost-btn w-full !py-2.5">
                <i class="fas fa-list text-xs"></i> View All Team Members
              </a>
            </div>
          </section>

          <section class="glass p-6 lg:col-span-3">
            <div class="flex items-center justify-between gap-4 mb-6">
              <div>
                <h2 class="text-lg font-bold mb-1">Recent Blogs</h2>
                <p class="text-sm text-gray-500">Your five latest posts.</p>
              </div>
              <a href="/admin/blogs" class="text-sm text-brand font-semibold inline-flex items-center gap-1.5 hover:gap-2.5 transition-all shrink-0">
                View All <i class="fas fa-arrow-right text-xs"></i>
              </a>
            </div>

            <div id="recentBlogs" class="space-y-3">
              <div class="animate-pulse space-y-3">
                <div class="h-14 rounded-xl bg-white/[0.04] border border-white/5"></div>
                <div class="h-14 rounded-xl bg-white/[0.04] border border-white/5"></div>
                <div class="h-14 rounded-xl bg-white/[0.04] border border-white/5"></div>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>

  <script>
    const escapeHtml = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    // Load statistics
    fetch("/api/blogs/all")
      .then(res => res.json())
      .then(blogs => {
        document.getElementById("blogCount").textContent = blogs.length;
        const totalViews = blogs.reduce((sum, b) => sum + (b.views || 0), 0);
        document.getElementById("totalViews").textContent = totalViews.toLocaleString();

        // Most recent post date
        const stamps = blogs
          .map(b => new Date(b.updatedAt || b.createdAt || 0).getTime())
          .filter(t => t > 0);
        if (stamps.length) {
          document.getElementById("lastUpdate").textContent =
            new Date(Math.max(...stamps)).toLocaleDateString("en-US", { month: "short", day: "numeric" });
        }

        // Show recent blogs
        const recentBlogs = blogs.slice(0, 5);
        const wrap = document.getElementById("recentBlogs");

        if (!recentBlogs.length) {
          wrap.innerHTML =
            '<div class="text-center py-10 rounded-xl border border-dashed border-white/10">' +
            '<i class="fas fa-feather text-3xl text-gray-700 mb-3"></i>' +
            '<p class="text-gray-500 text-sm mb-4">No blogs yet</p>' +
            '<a href="/admin/blogs/new" class="text-sm text-brand font-semibold hover:underline">Write your first post</a>' +
            '</div>';
          return;
        }

        wrap.innerHTML = recentBlogs.map(blog => `
          <a href="/admin/blogs/${encodeURIComponent(blog.id)}/edit"
             class="flex justify-between items-center gap-4 p-3.5 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.06] hover:border-brand/30 transition group">
            <div class="min-w-0">
              <p class="font-semibold text-sm text-white truncate group-hover:text-brand transition">${escapeHtml(blog.title)}</p>
              <div class="flex items-center gap-2 mt-1.5">
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-brand/10 border border-brand/25 text-brand font-medium">${escapeHtml(blog.category || "Uncategorized")}</span>
                <span class="text-[11px] ${blog.published ? "text-green-400" : "text-amber-400"}">
                  <i class="fas fa-circle text-[6px] align-middle mr-1"></i>${blog.published ? "Published" : "Draft"}
                </span>
              </div>
            </div>
            <span class="text-xs text-gray-500 shrink-0 whitespace-nowrap">
              <i class="fas fa-eye mr-1.5 text-gray-600"></i>${blog.views || 0}
            </span>
          </a>
        `).join("");
      })
      .catch(() => {
        document.getElementById("recentBlogs").innerHTML =
          '<div class="text-center py-10 rounded-xl border border-dashed border-white/10">' +
          '<i class="fas fa-triangle-exclamation text-2xl text-gray-700 mb-3"></i>' +
          '<p class="text-gray-500 text-sm">Could not load blogs right now.</p></div>';
      });

    fetch("/api/team")
      .then(res => res.json())
      .then(team => {
        document.getElementById("teamCount").textContent = team.length;
      })
      .catch(() => {});
  </script>
</body>
</html>
