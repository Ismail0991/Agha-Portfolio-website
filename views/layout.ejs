<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <!-- Set the saved theme before first paint to avoid a flash of the wrong colours. -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    })();
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== "undefined" ? title : "Aghaz Digital | Marketing, AI, Software & Branding Agency" %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Aghaz Digital builds the marketing, brand, AI, and software a growing business actually needs — one accountable team, scoped around your goals, not a template.' %>">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script>
    // Aghaz Digital brand palette: teal #14B8A6 / deep teal #0F766E / blue #3B82F6.
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: { 900: "#0A0F1C", 800: "#0F172A", 700: "#1E293B", 600: "#293548" },
            brand: { DEFAULT: "#14B8A6", dark: "#0F766E", light: "#2DD4BF", blue: "#3B82F6" },
          },
          fontFamily: {
            display: ["Poppins", "system-ui", "sans-serif"],
            sans: ["Inter", "system-ui", "sans-serif"],
          },
        },
      },
    };
  </script>
  <style>
    /* ===== Theme tokens ===== brand teal is shared; everything else flips. */
    :root, :root[data-theme="dark"] {
      --primary: #14b8a6;
      --primary-dark: #0f766e;
      --accent-blue: #3b82f6;
      --bg: #0a0f1c;
      --text: #cbd5e1;
      --text-strong: #ffffff;
      --text-muted: #94a3b8;
      --surface: rgba(255, 255, 255, 0.035);
      --surface-2: rgba(255, 255, 255, 0.06);
      --border: rgba(255, 255, 255, 0.09);
      --brand-text: #2dd4bf;
      --nav-bg: rgba(10, 15, 28, 0.7);
      --elevated: rgba(15, 23, 42, 0.95);
      --grid-line: rgba(255, 255, 255, 0.035);
      --track: #0a0f1c;
      --thumb: #29374d;
      --thumb-hover: #3a4a63;
      --glow-1: rgba(20, 184, 166, 0.14);
      --glow-2: rgba(59, 130, 246, 0.08);
    }
    :root[data-theme="light"] {
      --bg: #f1f5f9;
      --text: #475569;
      --text-strong: #0f172a;
      --text-muted: #64748b;
      --surface: rgba(15, 23, 42, 0.035);
      --surface-2: rgba(15, 23, 42, 0.07);
      --border: rgba(15, 23, 42, 0.12);
      --brand-text: #0f766e;
      --nav-bg: rgba(241, 245, 249, 0.82);
      --elevated: rgba(255, 255, 255, 0.97);
      --grid-line: rgba(15, 23, 42, 0.05);
      --track: #e2e8f0;
      --thumb: #cbd5e1;
      --thumb-hover: #94a3b8;
      --glow-1: rgba(20, 184, 166, 0.1);
      --glow-2: rgba(59, 130, 246, 0.07);
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: "Inter", system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      transition: background 0.3s ease, color 0.3s ease;
    }

    h1, h2, h3, h4 { font-family: "Poppins", system-ui, sans-serif; letter-spacing: -0.02em; color: var(--text-strong); }

    /* Ambient glow */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(60rem 40rem at 78% -10%, var(--glow-1), transparent 60%),
        radial-gradient(45rem 35rem at 3% 12%, var(--glow-2), transparent 55%);
    }
    body > * { position: relative; z-index: 1; }

    /* --- Components --- */
    .primary-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff; padding: 0.8rem 1.6rem; border-radius: 0.75rem; font-weight: 600;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 24px -8px rgba(20, 184, 166, 0.5);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease; cursor: pointer;
    }
    .primary-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -8px rgba(20, 184, 166, 0.7); filter: brightness(1.06); }

    .ghost-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.8rem 1.6rem; border-radius: 0.75rem; font-weight: 600;
      color: var(--text-strong); border: 1px solid var(--border); background: var(--surface);
      backdrop-filter: blur(8px);
      transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease; cursor: pointer;
    }
    .ghost-btn:hover { background: var(--surface-2); border-color: var(--primary); transform: translateY(-2px); }

    .glass {
      background: var(--surface); border: 1px solid var(--border); border-radius: 1rem;
      backdrop-filter: blur(10px);
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }
    .glass:hover { transform: translateY(-4px); border-color: rgba(20, 184, 166, 0.42); background: var(--surface-2); }

    .service-icon {
      width: 3rem; height: 3rem; border-radius: 0.85rem; display: flex; align-items: center; justify-content: center;
      color: var(--primary); font-size: 1.15rem;
      background: rgba(20, 184, 166, 0.12); border: 1px solid rgba(20, 184, 166, 0.28);
    }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.9rem; border-radius: 999px;
      font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--brand-text); background: rgba(20, 184, 166, 0.1); border: 1px solid rgba(20, 184, 166, 0.25);
    }

    .gradient-text {
      background: linear-gradient(120deg, var(--text-strong) 10%, var(--primary) 50%, var(--accent-blue) 95%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }

    .hero-section { background: transparent; }
    .nav-active { color: var(--brand-text) !important; font-weight: 600; }
    .red-accent { border-left: 3px solid var(--primary); padding-left: 1rem; }

    .field {
      width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 0.7rem;
      padding: 0.75rem 1rem; color: var(--text-strong);
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .field::placeholder { color: var(--text-muted); }
    .field:focus { outline: none; border-color: var(--primary); background: var(--surface-2); }

    .grid-bg {
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 40%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 40%, transparent 100%);
    }

    /* Reveal fallback (kept lightweight; AOS is the primary engine) */
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.visible { opacity: 1; transform: none; }

    /* Theme toggle button */
    .theme-toggle {
      display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px;
      color: var(--text-strong); border: 1px solid var(--border); background: var(--surface);
      cursor: pointer; transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .theme-toggle:hover { background: var(--surface-2); border-color: var(--primary); color: var(--primary); }

    /* Global scroll progress + back-to-top */
    .site-scroll-progress {
      position: fixed; top: 0; left: 0; height: 3px; width: 0;
      background: linear-gradient(90deg, var(--primary), var(--accent-blue)); z-index: 60; transition: width 0.1s linear;
    }
    .site-back-top {
      position: fixed; right: 1.25rem; bottom: 1.25rem; width: 46px; height: 46px; display: grid; place-items: center;
      border-radius: 12px; z-index: 55; color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 10px 26px -10px rgba(20, 184, 166, 0.7);
      opacity: 0; visibility: hidden; transform: translateY(12px); transition: all 0.25s ease;
    }
    .site-back-top.show { opacity: 1; visibility: visible; transform: translateY(0); }
    .site-back-top:hover { filter: brightness(1.1); transform: translateY(-2px); }

    ::selection { background: rgba(20, 184, 166, 0.35); }
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: var(--track); }
    ::-webkit-scrollbar-thumb { background: var(--thumb); border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--thumb-hover); }

    /* ===== Light-mode overrides for hardcoded Tailwind utilities used across pages ===== */
    :root[data-theme="light"] .text-white { color: var(--text-strong) !important; }
    :root[data-theme="light"] .text-gray-300,
    :root[data-theme="light"] .text-gray-400 { color: var(--text) !important; }
    :root[data-theme="light"] .text-gray-500,
    :root[data-theme="light"] .text-gray-600 { color: var(--text-muted) !important; }
    :root[data-theme="light"] .text-gray-700 { color: #cbd5e1 !important; }
    :root[data-theme="light"] .text-brand { color: var(--brand-text) !important; }
    :root[data-theme="light"] .text-white\/\[0\.06\] { color: rgba(15, 23, 42, 0.07) !important; }
    :root[data-theme="light"] .border-white\/10,
    :root[data-theme="light"] .border-white\/5 { border-color: var(--border) !important; }
    :root[data-theme="light"] .bg-white\/\[0\.02\] { background-color: rgba(15, 23, 42, 0.03) !important; }
    :root[data-theme="light"] .bg-white\/5 { background-color: rgba(15, 23, 42, 0.05) !important; }
    :root[data-theme="light"] .bg-white\/\[0\.06\] { background-color: rgba(15, 23, 42, 0.06) !important; }
    :root[data-theme="light"] .bg-ink-900\/70 { background-color: var(--nav-bg) !important; }
    :root[data-theme="light"] .bg-ink-900\/95 { background-color: rgba(241, 245, 249, 0.97) !important; }
    :root[data-theme="light"] .bg-ink-800\/60 { background-color: rgba(226, 232, 240, 0.6) !important; }
    :root[data-theme="light"] .bg-ink-800\/90,
    :root[data-theme="light"] .bg-ink-800\/95 { background-color: rgba(255, 255, 255, 0.95) !important; }
    :root[data-theme="light"] .from-ink-700 { --tw-gradient-from: #e2e8f0 var(--tw-gradient-from-position) !important; --tw-gradient-to: rgba(226, 232, 240, 0) var(--tw-gradient-to-position) !important; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important; }
    :root[data-theme="light"] .to-ink-900 { --tw-gradient-to: #f8fafc var(--tw-gradient-to-position) !important; }

    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; transition: none; }
      html { scroll-behavior: auto; }
      [data-aos] { opacity: 1 !important; transform: none !important; transition: none !important; }
    }
  </style>
</head>
<body>
  <div class="site-scroll-progress" id="siteScrollProgress"></div>

  <%- include("partials/navbar") %>
  <main><%- body %></main>
  <%- include("partials/footer") %>

  <a href="#" class="site-back-top" id="siteBackTop" aria-label="Back to top"><i class="fas fa-arrow-up"></i></a>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    // ----- Theme toggle -----
    (() => {
      const root = document.documentElement;
      const syncIcons = (t) => {
        document.querySelectorAll("[data-theme-toggle] i").forEach((ic) => {
          ic.className = t === "light" ? "fas fa-moon" : "fas fa-sun";
        });
      };
      const apply = (t) => {
        root.setAttribute("data-theme", t);
        try { localStorage.setItem("theme", t); } catch (e) {}
        syncIcons(t);
        if (window.AOS) AOS.refresh();
      };
      syncIcons(root.getAttribute("data-theme"));
      document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          apply(root.getAttribute("data-theme") === "light" ? "dark" : "light");
        });
      });
    })();

    // ----- AOS scroll animations (replay on scroll), with a fail-safe -----
    (() => {
      const revealAll = () => {
        const s = document.createElement("style");
        s.textContent = "[data-aos]{opacity:1 !important;transform:none !important;}";
        document.head.appendChild(s);
      };
      try {
        if (window.AOS) {
          AOS.init({ duration: 700, once: false, mirror: true, offset: 80, easing: "ease-out-cubic" });
        } else { revealAll(); }
      } catch (e) { revealAll(); }
      setTimeout(() => { if (!window.AOS) revealAll(); }, 2500);
    })();

    // ----- Reveal fallback for any legacy .reveal elements (replays) -----
    (() => {
      const els = document.querySelectorAll(".reveal");
      if (!els.length) return;
      if (!("IntersectionObserver" in window)) { els.forEach((el) => el.classList.add("visible")); return; }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => e.target.classList.toggle("visible", e.isIntersecting));
      }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
      els.forEach((el) => io.observe(el));
    })();

    // ----- Scroll progress + back-to-top -----
    (() => {
      const bar = document.getElementById("siteScrollProgress");
      const top = document.getElementById("siteBackTop");
      const onScroll = () => {
        const el = document.documentElement;
        const max = el.scrollHeight - el.clientHeight;
        const pct = max > 0 ? (el.scrollTop / max) * 100 : 0;
        if (bar) bar.style.width = pct + "%";
        if (top) top.classList.toggle("show", el.scrollTop > 500);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      if (top) top.addEventListener("click", (e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); });
    })();

    // ----- Count-up for [data-count] -----
    (() => {
      const nums = document.querySelectorAll("[data-count]");
      if (!nums.length || !("IntersectionObserver" in window)) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          io.unobserve(el);
          const target = parseInt(el.dataset.count, 10);
          const suffix = el.dataset.suffix || "";
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { el.textContent = target + suffix; return; }
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min((now - start) / 1400, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.5 });
      nums.forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>
