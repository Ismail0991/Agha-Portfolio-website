<!-- ============================ HERO ============================ -->
<section class="hero-section relative overflow-hidden">
  <div class="absolute inset-0 grid-bg pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 pt-20 pb-16 lg:pt-28 lg:pb-20">
    <div class="max-w-3xl">
      <div class="eyebrow mb-6 reveal">
        <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
        Contact Us
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.08] mb-6 reveal">
        Tell us what you're <span class="gradient-text">trying to fix.</span>
      </h1>

      <p class="text-lg text-gray-400 leading-relaxed max-w-xl mb-9 reveal">
        Marketing, brand, technology, or all three — tell us your bottleneck and
        we'll tell you the right starting point.
      </p>

      <div class="flex flex-wrap gap-3 reveal">
        <a href="#contactForm" class="primary-btn">
          Request a Consultation <i class="fas fa-arrow-right text-xs"></i>
        </a>
        <a href="#contactForm" class="ghost-btn">
          <i class="fas fa-paper-plane text-xs"></i> Send a Message
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ==================== CONTACT INFO + FORM ==================== -->
<section class="py-24 border-t border-white/10 bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-4">
    <div class="max-w-3xl mb-14 reveal">
      <div class="eyebrow mb-4">A Conversation, Not a Pitch</div>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Every engagement starts with <span class="gradient-text">a conversation</span>
      </h2>
      <p class="text-gray-400 leading-relaxed">
        Every engagement starts with a conversation, not a sales pitch. Tell us what's
        going on in your business, and we'll walk through whether we're the right fit
        and what a project would actually involve.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- ------------------ Contact information ------------------ -->
      <div class="lg:col-span-5 reveal">
        <div class="eyebrow mb-4">Details</div>
        <h2 class="text-2xl font-bold mb-4">How to reach us</h2>
        <p class="text-gray-400 leading-relaxed mb-10">
          Prefer to reach out directly? Send us a note and a real person on the
          team will pick it up.
        </p>

        <div class="space-y-4">
          <div class="glass p-6 flex items-start gap-4">
            <span class="service-icon shrink-0"><i class="fas fa-envelope"></i></span>
            <div>
              <h3 class="font-semibold mb-1">Email</h3>
              <p class="text-sm text-gray-400 leading-relaxed">
                <a href="mailto:hello@aghazdigital.com" class="hover:text-brand transition">hello@aghazdigital.com</a>
              </p>
            </div>
          </div>

          <div class="glass p-6 flex items-start gap-4">
            <span class="service-icon shrink-0"><i class="fas fa-calendar-check"></i></span>
            <div>
              <h3 class="font-semibold mb-1">Request a Consultation</h3>
              <p class="text-sm text-gray-400 leading-relaxed">
                Tell us about your business and your goals, and we'll respond to schedule a call.
              </p>
            </div>
          </div>

          <div class="glass p-6 flex items-start gap-4">
            <span class="service-icon shrink-0"><i class="fas fa-handshake-angle"></i></span>
            <div>
              <h3 class="font-semibold mb-1">Free, no-obligation first call</h3>
              <p class="text-sm text-gray-400 leading-relaxed">
                The first conversation is about fit and scope — never a sales pitch.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ---------------------- Message form ---------------------- -->
      <div class="lg:col-span-7 reveal">
        <div class="relative">
          <div class="absolute -inset-4 bg-brand/10 blur-3xl rounded-full pointer-events-none"></div>

          <div class="relative glass !rounded-2xl p-8 sm:p-10">
            <div class="eyebrow mb-4">Start Here</div>
            <h2 class="text-3xl font-bold mb-3">Send us a Message</h2>
            <p class="text-gray-400 leading-relaxed mb-8">
              The more you tell us about the problem, the more useful our first reply will be.
            </p>

            <form id="contactForm" class="space-y-5 scroll-mt-24">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="contactName" class="block text-sm font-semibold text-gray-300 mb-2">Name</label>
                  <input id="contactName" type="text" name="name" required
                         placeholder="Jane Doe" class="field">
                </div>
                <div>
                  <label for="contactEmail" class="block text-sm font-semibold text-gray-300 mb-2">Email</label>
                  <input id="contactEmail" type="email" name="email" required
                         placeholder="jane@company.com" class="field">
                </div>
              </div>

              <div>
                <label for="contactSubject" class="block text-sm font-semibold text-gray-300 mb-2">Subject</label>
                <input id="contactSubject" type="text" name="subject" required
                       placeholder="What can we help with?" class="field">
              </div>

              <div>
                <label for="contactMessage" class="block text-sm font-semibold text-gray-300 mb-2">Message</label>
                <textarea id="contactMessage" name="message" rows="6" required
                          placeholder="Tell us about your business, your goals, and the problem you want to solve."
                          class="field resize-y"></textarea>
              </div>

              <button type="submit" class="primary-btn w-full">
                Send Message <i class="fas fa-paper-plane text-xs"></i>
              </button>

              <p class="text-xs text-gray-600 text-center pt-1">
                <i class="fas fa-lock mr-1"></i> Your details stay with us — we never share or sell them.
              </p>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

