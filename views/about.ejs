<!-- ============================ HERO ============================ -->
<section class="hero-section relative overflow-hidden">
  <div class="absolute inset-0 grid-bg pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 pt-20 pb-20 lg:pt-28 lg:pb-24">
    <div class="max-w-3xl">
      <div class="eyebrow mb-6 reveal">
        <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
        About Us
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.08] mb-6 reveal">
        The team behind<br>
        <span class="gradient-text">your digital growth</span>
      </h1>

      <p class="text-lg text-gray-400 leading-relaxed max-w-xl mb-9 reveal">
        Learn more about DigitalHub and our mission — who we are, how we think,
        and why clients keep coming back long after launch day.
      </p>

      <div class="flex flex-wrap gap-3 reveal">
        <a href="/contact" class="primary-btn">
          Work With Us <i class="fas fa-arrow-right text-xs"></i>
        </a>
        <a href="/services" class="ghost-btn">
          <i class="fas fa-layer-group text-xs"></i> See Our Services
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ========================= STATS STRIP ========================= -->
<section class="border-y border-white/10 bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center reveal">
      <div>
        <p class="text-3xl sm:text-4xl font-bold text-brand font-display" data-count="5" data-suffix="+">0</p>
        <p class="text-sm text-gray-500 mt-2">Years of Experience</p>
      </div>
      <div class="lg:border-x border-white/10">
        <p class="text-3xl sm:text-4xl font-bold text-brand font-display" data-count="30" data-suffix="+">0</p>
        <p class="text-sm text-gray-500 mt-2">Companies Helped</p>
      </div>
      <div class="lg:border-r border-white/10">
        <p class="text-3xl sm:text-4xl font-bold text-brand font-display" data-count="50" data-suffix="+">0</p>
        <p class="text-sm text-gray-500 mt-2">Projects Delivered</p>
      </div>
      <div>
        <p class="text-3xl sm:text-4xl font-bold text-brand font-display" data-count="4" data-suffix="">0</p>
        <p class="text-sm text-gray-500 mt-2">Core Disciplines</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================= WE ARE DIGITALHUB ========================= -->
<section class="py-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
      <div class="reveal">
        <div class="relative">
          <div class="absolute -inset-4 bg-brand/20 blur-3xl rounded-full"></div>
          <div class="relative glass p-3 !rounded-2xl">
            <img src="<%= siteImages['about.story'] %>"
                 alt="About Us"
                 loading="lazy"
                 class="rounded-xl w-full h-[420px] object-cover">
            <div class="absolute -bottom-5 -left-5 glass !rounded-xl px-4 py-3 flex items-center gap-3 bg-ink-800/90">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-brand/15 border border-brand/30 text-brand">
                <i class="fas fa-people-group"></i>
              </span>
              <div>
                <p class="text-sm font-semibold leading-tight">One senior team</p>
                <p class="text-xs text-gray-500">No handoffs, no juniors</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal">
        <div class="eyebrow mb-4">Who We Are</div>
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">
          We Are <span class="gradient-text">DigitalHub</span>
        </h2>
        <p class="text-gray-400 leading-relaxed mb-4">
          We are a team of passionate digital experts dedicated to transforming businesses through innovative technology solutions.
        </p>
        <p class="text-gray-400 leading-relaxed mb-4">
          With over 5 years of experience, we've helped 30+ companies achieve their digital goals through web development, app creation, digital marketing, and YouTube automation.
        </p>

        <div class="space-y-5 mt-9">
          <div class="flex items-start gap-4">
            <span class="service-icon shrink-0"><i class="fas fa-check-circle"></i></span>
            <div>
              <h3 class="font-bold text-lg mb-1">Innovation First</h3>
              <p class="text-sm text-gray-400 leading-relaxed">We stay ahead of technology trends to deliver cutting-edge solutions.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="service-icon shrink-0"><i class="fas fa-check-circle"></i></span>
            <div>
              <h3 class="font-bold text-lg mb-1">Client Focused</h3>
              <p class="text-sm text-gray-400 leading-relaxed">Your success is our success. We're committed to delivering results.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="service-icon shrink-0"><i class="fas fa-check-circle"></i></span>
            <div>
              <h3 class="font-bold text-lg mb-1">Expert Team</h3>
              <p class="text-sm text-gray-400 leading-relaxed">Our team consists of skilled professionals with diverse expertise.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========================= MISSION & VALUES ========================= -->
<section class="py-24 border-y border-white/10 bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-4">
    <div class="max-w-2xl mb-14 reveal">
      <div class="eyebrow mb-4">Our Mission</div>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Technology that earns <span class="gradient-text">its keep</span>
      </h2>
      <p class="text-gray-400 leading-relaxed">
        Our mission is simple — help businesses use technology to grow, not just to
        look modern. Every decision we make traces back to that.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="glass p-7 reveal">
        <div class="service-icon mb-5"><i class="fas fa-lightbulb"></i></div>
        <h3 class="text-lg font-bold mb-2.5">Curiosity</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          We ask the awkward questions early, because the wrong assumption is far more expensive at the end.
        </p>
      </div>
      <div class="glass p-7 reveal">
        <div class="service-icon mb-5"><i class="fas fa-handshake-angle"></i></div>
        <h3 class="text-lg font-bold mb-2.5">Honesty</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          If an idea will not work, we say so before you pay for it. Straight answers beat comfortable ones.
        </p>
      </div>
      <div class="glass p-7 reveal">
        <div class="service-icon mb-5"><i class="fas fa-gauge-high"></i></div>
        <h3 class="text-lg font-bold mb-2.5">Craft</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Clean, documented, tested code you could hand to any developer tomorrow without apology.
        </p>
      </div>
      <div class="glass p-7 reveal">
        <div class="service-icon mb-5"><i class="fas fa-seedling"></i></div>
        <h3 class="text-lg font-bold mb-2.5">Longevity</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          We build for the version of your business that exists in three years, not just today.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ========================= OUR TEAM CULTURE ========================= -->
<section class="py-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="max-w-2xl mb-14 reveal">
      <div class="eyebrow mb-4">Inside the Team</div>
      <h2 class="text-3xl sm:text-4xl font-bold">
        Our <span class="gradient-text">Team Culture</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
      <div class="reveal">
        <div class="relative">
          <div class="absolute -inset-4 bg-brand/15 blur-3xl rounded-full"></div>
          <div class="relative glass p-3 !rounded-2xl">
            <img src="<%= siteImages['about.culture'] %>"
                 alt="Team Culture"
                 loading="lazy"
                 class="rounded-xl w-full h-[400px] object-cover">
          </div>
        </div>
      </div>

      <div class="reveal">
        <p class="text-gray-400 leading-relaxed mb-4">
          At DigitalHub, we believe in creating an environment where creativity and collaboration thrive. Our team is driven by a passion for technology and a commitment to excellence.
        </p>
        <p class="text-gray-400 leading-relaxed mb-4">
          We foster a culture of continuous learning, where every team member has the opportunity to grow and develop their skills.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
          <div class="red-accent">
            <h3 class="font-semibold mb-1">Learning Time, Protected</h3>
            <p class="text-sm text-gray-400 leading-relaxed">Every week includes dedicated hours for courses, experiments and side builds.</p>
          </div>
          <div class="red-accent">
            <h3 class="font-semibold mb-1">Remote-Friendly</h3>
            <p class="text-sm text-gray-400 leading-relaxed">Work where you do your best thinking. We optimise for output, not chairs.</p>
          </div>
          <div class="red-accent">
            <h3 class="font-semibold mb-1">Flat by Design</h3>
            <p class="text-sm text-gray-400 leading-relaxed">The best argument wins, regardless of who made it or how long they've been here.</p>
          </div>
          <div class="red-accent">
            <h3 class="font-semibold mb-1">Ownership, Not Tickets</h3>
            <p class="text-sm text-gray-400 leading-relaxed">People own outcomes end to end and talk to clients directly.</p>
          </div>
        </div>

        <a href="/contact" class="primary-btn mt-8">
          Join Our Team <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ========================= OUR JOURNEY ========================= -->
<section class="py-24 border-y border-white/10 bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center mb-16 reveal">
